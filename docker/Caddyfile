{$DOMAIN} {
	encode zstd gzip
	root * /srv

	handle /api/* {
		reverse_proxy {$BACKEND_URL} {
			header_up Host {$API_DOMAIN}
		}
	}

	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy {$BACKEND_URL}
}
